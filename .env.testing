APP_NAME="POS Restaurant Test"
APP_ENV=testing
APP_KEY=base64:2fl+Ktvkfl+Fuz4Qp/A75G2RTiWVA/ZoKZvp6fiiM10=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pos_restaurant_test
DB_USERNAME=postgres
DB_PASSWORD=secret

CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

JWT_SECRET=test-jwt-secret-key-for-testing-only-32chars!

# F2.3: Broadcasting config para tests
BROADCAST_CONNECTION=log
REVERB_APP_KEY=test-key
REVERB_APP_SECRET=test-secret
REVERB_APP_ID=test-app
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# SQLite local para testing - :memory: evita SQLiteDatabaseDoesNotExistException
# cuando RefreshDatabase ejecuta las migraciones antes de que SchemaVersionManager
# configure la conexión con la ruta temporal del test.
SQLITE_LOCAL_PATH=:memory:
